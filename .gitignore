# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local

# 离线单文件包：产物几十 MB、属于一次性交付物，不入库（构建脚本已入库，随时可重生成）
offline
offline-dist

# Local project memory / config (not source)
.workbuddy

# 一次性抓取/调试的中间产物（模板原始 JSON、预览 SVG、探针脚本、静态服务器日志）
# 体积大且可重生成：scripts/y56y/*.mjs 随时能重新抓取并转换
.tmp

# 一次性调试探针（scripts/y56y/ 下的正式工具脚本仍入库）
scripts/probe-*.js

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.*
